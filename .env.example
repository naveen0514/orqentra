# Portal discovery defaults. Restrict this to exact portal hosts in production.
ORQENTRA_ALLOWED_PORTAL_HOSTS=*
ORQENTRA_COUNTRY=India
ORQENTRA_HEADLESS=false

# Optional local Ollama fallback. RAG and deterministic extraction run first.
ORQENTRA_OLLAMA_ENABLED=false
ORQENTRA_OLLAMA_MODEL=llama3
ORQENTRA_OLLAMA_HOST=http://127.0.0.1:11434

# Optional frontend URL override.
VITE_API_URL=http://127.0.0.1:8000
